<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jake Frost" Width="510" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="#EAF1EE" UseLayoutRounding="True">
  <Window.Resources>
    <ControlTemplate x:Key="ToolTile" TargetType="RadioButton">
      <Border x:Name="TileFrame" CornerRadius="5" Background="#22383B" BorderBrush="#344B4D" BorderThickness="1" Padding="6">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileFrame" Property="Background" Value="#344C4D"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="TileFrame" Property="Background" Value="#375249"/><Setter TargetName="TileFrame" Property="BorderBrush" Value="#9ABBA5"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileFrame" Property="BorderBrush" Value="#F2D19C"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button" x:Key="Button">
      <Setter Property="Foreground" Value="#DCEAE6"/><Setter Property="Background" Value="#263B40"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.80"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.61"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.43"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E5BA86"/><Setter TargetName="Frame" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button}"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#102024"/><Setter Property="Foreground" Value="#E6F1E9"/>
      <Setter Property="BorderBrush" Value="#46605D"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#D9ECD9"/><Setter Property="SelectionBrush" Value="#608678"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6F1E9"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Cell" Padding="{TemplateBinding Padding}" Background="#21363A"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Cell" Property="Background" Value="#3C5651"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="#355149"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6F1E9"/><Setter Property="MinHeight" Value="27"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Drop" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border CornerRadius="4" Background="#20363A" BorderBrush="#455C59" BorderThickness="1">
                <Path HorizontalAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center" Stroke="#C4D6CB" StrokeThickness="1.4" Data="M0,0 L3,3 L6,0"/>
              </Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="7,2,23,2" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True">
            <Border MinWidth="{Binding ActualWidth, ElementName=Drop}" MaxHeight="300" Background="#21363A" BorderBrush="#567269" BorderThickness="1" CornerRadius="4" Padding="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="RepeatButton" x:Key="InvisibleTrack">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="Transparent">
          <Border Height="4" Margin="7,0" Background="#4C6464" CornerRadius="2" VerticalAlignment="Center"/>
          <Border Width="1" Height="10" Background="#7E9991" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleTrack}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="17" Height="17"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Ellipse x:Name="Grip" Fill="#C4E1CD" Stroke="#56756B" StrokeThickness="1"/>
              <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Fill" Value="#FBE2AF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleTrack}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="Switch" Width="29" Height="17" CornerRadius="9" Background="#526365" Margin="0,0,9,0" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="11" Height="11" Fill="#EAF0E8" HorizontalAlignment="Left" Margin="3,0"/>
          </Border>
          <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#91BAA3"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Dot" Property="Fill" Value="#1C3830"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="#F1CD9A"/><Setter TargetName="Switch" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B5C8C4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Frame" Padding="3,7" Background="Transparent" CornerRadius="5">
          <ContentPresenter HorizontalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#304448"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#385450"/><Setter Property="Foreground" Value="#EAF8ED"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E5BA86"/><Setter TargetName="Frame" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="VisitorSizeSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="Minimum" Value="50"/><Setter Property="Maximum" Value="250"/>
      <Setter Property="SmallChange" Value="5"/><Setter Property="LargeChange" Value="25"/>
      <Setter Property="TickFrequency" Value="5"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Border CornerRadius="15" BorderThickness="1" BorderBrush="#43575B" Background="#16282C" ClipToBounds="True">
   <Grid>
    <DockPanel x:Name="ExpandedPanel">
      <Grid x:Name="TitleBar" DockPanel.Dock="Top" Margin="19,13,12,12" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Viewbox Width="24" Height="24" Margin="0,0,9,0"><Path Stroke="#C6E4D7" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1 L12,23 M2.5,6.5 L21.5,17.5 M2.5,17.5 L21.5,6.5 M8.7,4.3 L12,7.5 15.3,4.3 M8.7,19.7 L12,16.5 15.3,19.7 M3.5,10.9 L8,9.7 6.8,5.1 M17.2,18.9 L16,14.3 20.5,13.1 M3.5,13.1 L8,14.3 6.8,18.9 M17.2,5.1 L16,9.7 20.5,10.9"/></Viewbox>
        <TextBlock Grid.Column="1" Text="Jake Frost" FontFamily="Georgia" FontSize="23" VerticalAlignment="Center"/>
        <Button x:Name="PauseButton" Grid.Column="2" Content="Pause snow" Margin="0,0,9,0" Padding="11,5" ToolTip="Pause or resume falling snow"/>
        <Button x:Name="MinimizeButton" Grid.Column="3" Content="−" FontSize="17" Padding="8,1" Background="Transparent" ToolTip="Minimize here" AutomationProperties.Name="Minimize here"/>
        <Button x:Name="HideButton" Grid.Column="4" Background="Transparent" FontSize="18" Padding="6,0" Foreground="#ABBFBB" Content="×" ToolTip="Hide in system tray" AutomationProperties.Name="Hide in system tray"/>
      </Grid>
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <StackPanel>
      <Border Margin="17,10,17,0" Background="#102024" Padding="3" CornerRadius="7">
        <UniformGrid Columns="4"><RadioButton x:Name="WorkshopTab" GroupName="PanelTab" Content="Workshop" IsChecked="True"/><RadioButton x:Name="WeatherTab" GroupName="PanelTab" Content="Weather"/><RadioButton x:Name="DecorTab" GroupName="PanelTab" Content="Decorate"/><RadioButton x:Name="FriendsTab" GroupName="PanelTab" Content="Friends"/></UniformGrid>
      </Border>
      <StackPanel x:Name="WorkshopPane" Margin="15,12,15,0">
        <TextBlock Text="Choose a tool, then use it on your desktop. Press Esc when you’re done." TextWrapping="Wrap" Foreground="#C5DDD0" Margin="3,0,3,8"/>
        <Border x:Name="ToolsHost"/>
        <CheckBox x:Name="GrabOption" Margin="3,12,3,3" Foreground="#D3DFD9" Cursor="Hand" Content="Grab, roll and throw snow directly on my desktop"/>
        <Grid Margin="3,13,3,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Label}" Text="New light strings" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Border Grid.Column="1" Background="#102024" CornerRadius="7" Padding="3">
            <UniformGrid Columns="3"><RadioButton x:Name="Warm" Content="Candlelight" GroupName="Colors"/><RadioButton x:Name="Festive" Content="Festive" GroupName="Colors"/><RadioButton x:Name="Aurora" Content="Aurora" GroupName="Colors"/></UniformGrid>
          </Border>
        </Grid>
        <WrapPanel Margin="3,7,3,2">
          <CheckBox x:Name="PuffOption" Margin="0,7,17,0" Foreground="#D3DFD9" Cursor="Hand" Content="Puff flakes on click" ToolTip="Click a falling flake while using your apps. The flake lets your click through."/>
          <CheckBox x:Name="RememberOption" Margin="0,7,0,0" Foreground="#D3DFD9" Cursor="Hand" Content="Remember decorations and snowmen" ToolTip="Restore your desktop decorations and completed snowmen when Jake Frost opens again."/>
        </WrapPanel>
        <DockPanel Margin="3,14,3,3">
          <TextBlock Text="Visitor speed" Style="{StaticResource Label}" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Border Background="#102024" CornerRadius="7" Padding="3"><UniformGrid Columns="3">
            <RadioButton x:Name="VisitorSpeed0" GroupName="VisitorSpeed" Content="Leisurely"/>
            <RadioButton x:Name="VisitorSpeed1" GroupName="VisitorSpeed" Content="Steady"/>
            <RadioButton x:Name="VisitorSpeed2" GroupName="VisitorSpeed" Content="Brisk"/>
          </UniformGrid></Border>
        </DockPanel>
        <WrapPanel Margin="1,5,0,0">
          <Button x:Name="PloughButton" Content="Snowplough" Margin="2" Padding="8,5"/>
          <Button x:Name="SnowmenButton" Content="Send snowmen" Margin="2" Padding="8,5"/>
          <Button x:Name="YetiButton" Content="Send Yeti" Margin="2" Padding="8,5"/>
          <Button x:Name="SantaButton" Content="Send Santa" Margin="2" Padding="8,5"/>
        </WrapPanel>
        <Expander x:Name="VisitorSizeOptions" Header="Visitor sizes" Margin="3,9,3,1" Foreground="#D3DFD9">
          <Grid Margin="18,6,3,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/><RowDefinition Height="29"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Snowplow" VerticalAlignment="Center"/>
            <Slider x:Name="SizeSnowplow" Grid.Row="0" Grid.Column="1" Style="{StaticResource VisitorSizeSlider}" AutomationProperties.Name="Snowplow size"/>
            <TextBlock x:Name="SizeSnowplowLabel" Grid.Row="0" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Yeti" VerticalAlignment="Center"/>
            <Slider x:Name="SizeYeti" Grid.Row="1" Grid.Column="1" Style="{StaticResource VisitorSizeSlider}" AutomationProperties.Name="Yeti size"/>
            <TextBlock x:Name="SizeYetiLabel" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Santa &amp; reindeer" VerticalAlignment="Center"/>
            <Slider x:Name="SizeSanta" Grid.Row="2" Grid.Column="1" Style="{StaticResource VisitorSizeSlider}" AutomationProperties.Name="Santa &amp; reindeer size"/>
            <TextBlock x:Name="SizeSantaLabel" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Text="Elf train" VerticalAlignment="Center"/>
            <Slider x:Name="SizeTrain" Grid.Row="3" Grid.Column="1" Style="{StaticResource VisitorSizeSlider}" AutomationProperties.Name="Elf train size"/>
            <TextBlock x:Name="SizeTrainLabel" Grid.Row="3" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" Text="Visiting snowmen" VerticalAlignment="Center"/>
            <Slider x:Name="SizeSnowmen" Grid.Row="4" Grid.Column="1" Style="{StaticResource VisitorSizeSlider}" AutomationProperties.Name="Visiting snowmen size"/>
            <TextBlock x:Name="SizeSnowmenLabel" Grid.Row="4" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Expander>
      </StackPanel>
      <StackPanel x:Name="WeatherPane" Visibility="Collapsed" Margin="18,12,18,0">
        <TextBlock Text="Desktop effect" Style="{StaticResource Label}" Margin="0,0,0,5"/>
        <Border Background="#102024" CornerRadius="7" Padding="3"><UniformGrid Columns="4">
          <RadioButton x:Name="ModeSnow" GroupName="WeatherMode" Content="Snow"/><RadioButton x:Name="ModeHeavySnow" GroupName="WeatherMode" Content="Heavy snow"/>
          <RadioButton x:Name="ModeRain" GroupName="WeatherMode" Content="Rain"/><RadioButton x:Name="ModeSakura" GroupName="WeatherMode" Content="Sakura"/>
          <RadioButton x:Name="ModeLeaves" GroupName="WeatherMode" Content="Leaves"/><RadioButton x:Name="ModeFireflies" GroupName="WeatherMode" Content="Fireflies"/>
          <RadioButton x:Name="ModeStarfall" GroupName="WeatherMode" Content="Starfall"/><RadioButton x:Name="ModeOff" GroupName="WeatherMode" Content="Off"/>
        </UniformGrid></Border>
        <DockPanel Margin="0,9,0,6">
          <TextBlock Text="Follow" Style="{StaticResource Label}" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Border Background="#102024" CornerRadius="7" Padding="2"><UniformGrid Columns="4">
             <RadioButton x:Name="ScheduleManual" GroupName="Schedule" Content="Manual"/><RadioButton x:Name="ScheduleRandom" GroupName="Schedule" Content="Random"/>
             <RadioButton x:Name="ScheduleSeason" GroupName="Schedule" Content="Season"/><RadioButton x:Name="ScheduleLocal" GroupName="Schedule" Content="My weather"/>
          </UniformGrid></Border>
        </DockPanel>
        <StackPanel x:Name="LocalWeatherBox" Visibility="Collapsed">
          <TextBlock Text="City or coordinates for Open-Meteo" Foreground="#BBD0C6" Margin="0,0,0,4"/>
          <DockPanel><Button x:Name="WeatherLookup" DockPanel.Dock="Right" Content="Match weather" Padding="10,4" Margin="7,0,0,0"/><TextBox x:Name="WeatherCity" MaxLength="100" Padding="6,4" AutomationProperties.Name="City or coordinates"/></DockPanel>
        </StackPanel>
        <TextBlock x:Name="ScheduleStatus" Margin="0,3,0,6" TextWrapping="Wrap" Foreground="#BBD0C6" FontSize="12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="238"/></Grid.ColumnDefinitions>
          <TextBlock Text="Snowfall" Style="{StaticResource Label}" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Padding="3" Background="#102024" CornerRadius="7">
            <UniformGrid Columns="3"><RadioButton x:Name="Light" Content="Light"/><RadioButton x:Name="Steady" Content="Steady"/><RadioButton x:Name="Flurry" Content="Flurry"/></UniformGrid>
          </Border>
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="99"/><ColumnDefinition/><ColumnDefinition Width="63"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="33"/><RowDefinition Height="33"/></Grid.RowDefinitions>
          <TextBlock Text="Snow volume" Style="{StaticResource Label}" VerticalAlignment="Center"/>
          <Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="400" TickFrequency="25" SmallChange="25" LargeChange="100" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Snow volume" ToolTip="Amount of new snowfall. 100% is the original rate."/>
          <TextBlock x:Name="VolumeLabel" Grid.Column="2" TextAlignment="Right" Foreground="#C1D4C8" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="Drift depth" Style="{StaticResource Label}" VerticalAlignment="Center"/>
          <Slider x:Name="Depth" Grid.Row="1" Grid.Column="1" Minimum="24" Maximum="140" TickFrequency="4" SmallChange="4" LargeChange="20" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Maximum drift depth" ToolTip="Maximum height for accumulated and hand-piled snow."/>
          <TextBlock x:Name="DepthLabel" Grid.Row="1" Grid.Column="2" TextAlignment="Right" Foreground="#C1D4C8" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Text="Wind" Style="{StaticResource Label}" VerticalAlignment="Center"/>
          <Slider x:Name="Wind" Grid.Row="2" Grid.Column="1" Minimum="-80" Maximum="80" TickFrequency="10" SmallChange="10" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Wind direction and strength"/>
          <TextBlock x:Name="WindLabel" Grid.Row="2" Grid.Column="2" TextAlignment="Right" Foreground="#C1D4C8" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="99"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="Window ice" Style="{StaticResource Label}" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Padding="3" Background="#102024" CornerRadius="7">
            <UniformGrid Columns="4"><RadioButton x:Name="IceOff" Content="Off"/><RadioButton x:Name="IceFrost" Content="Frost"/><RadioButton x:Name="IceIcicles" Content="Icicles"/><RadioButton x:Name="IceDeep" Content="Deep ice"/></UniformGrid>
          </Border>
        </Grid>
        <CheckBox x:Name="FullscreenOption" Margin="0,14,0,2" Foreground="#D3DFD9" Cursor="Hand" Content="Pause over fullscreen apps"/>
        <WrapPanel><CheckBox x:Name="LightningOption" Margin="0,7,14,2" Foreground="#D3DFD9" Content="Lightning in rain"/><CheckBox x:Name="BatteryOption" Margin="0,7,0,2" Foreground="#D3DFD9" Content="Save power on battery"/></WrapPanel>
        <Expander x:Name="DisplayOptions" Header="Display and seasonal options" Foreground="#D3DFD9" Margin="0,9,0,0">
          <StackPanel Margin="18,5,0,2">
            <CheckBox x:Name="BehindOption" Content="Show effects behind app windows" Margin="0,3" Foreground="#D3DFD9"/>
            <CheckBox x:Name="BanksOption" Content="Let snow settle on window edges" Margin="0,3" Foreground="#D3DFD9"/>
            <CheckBox x:Name="VisitsOption" Content="Occasional Santa and snowplough visits" Margin="0,3" Foreground="#D3DFD9"/>
            <CheckBox x:Name="HemisphereOption" Content="Use southern hemisphere seasons" Margin="0,3" Foreground="#D3DFD9"/>
            <TextBlock Text="Show effects on" Margin="0,8,0,3" FontWeight="SemiBold"/>
            <WrapPanel x:Name="ScreenOptions"/>
          </StackPanel>
        </Expander>
      </StackPanel>
      <Border x:Name="DecorPane" Visibility="Collapsed" Margin="16,12,16,0"/>
      <Border x:Name="FriendsHost" Visibility="Collapsed" Margin="16,12,16,0"/>
      <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ClearButton" Background="Transparent" Foreground="#AEC2BD" Padding="6,5" Content="Clear scene"/>
          <Button x:Name="QuitButton" Background="Transparent" Foreground="#AEC2BD" Padding="6,5" Margin="5,0,0,0" Content="Quit"/>
        </StackPanel>
      </Grid>
       </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <DockPanel x:Name="CompactPanel" Visibility="Collapsed" Background="Transparent" Margin="8,5">
      <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="Done" Background="#BDDCCB" Foreground="#18352C" Padding="9,4" Margin="4,0,0,0"/>
      <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore" Padding="9,4" ToolTip="Open the full panel here"/>
      <TextBlock x:Name="CompactTitle" Text="Jake Frost" FontWeight="SemiBold" Foreground="#CEE4DA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0"/>
    </DockPanel>
   </Grid>
  </Border>
</Window>
